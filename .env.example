# LiveKit Cloud project
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM: groq or openai
LLM_PROVIDER=groq
# Groq model id (or OpenAI model id when LLM_PROVIDER=openai)
LLM_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
CONVERSATION_LANGUAGE=English
GROQ_API_KEY=
OPENAI_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Avatar
AVATAR_MODEL_VARIANT=lite
AVATAR_REFERENCE_IMAGE_PATH=assets/avatar_face.png

# Local service addresses (defaults are fine on one machine)
SPEECH_SERVER_HOST=127.0.0.1
SPEECH_SERVER_PORT=8101
AVATAR_SERVER_HOST=127.0.0.1
AVATAR_SERVER_PORT=8102
TOKEN_SERVER_HOST=0.0.0.0
TOKEN_SERVER_PORT=8100
